---
import { getTranslations } from "../i18n/utils";
const t = getTranslations(Astro.currentLocale);
---

<div
    class="space-y-5 text-base md:text-lg leading-relaxed text-gray-600 dark:text-gray-400"
>
    <p>
        {t.about.paragraph1}
        <strong class="text-gray-900 dark:text-white"
            >{t.about.role}</strong
        >{t.about.paragraph1End}
    </p>

    <p>
        {t.about.paragraph2}
        <strong class="text-gray-900 dark:text-white">
            {t.about.skill1}
        </strong>{t.about.paragraph2_1}<i>{t.about.skill2}</i>{t.about.paragraph2End}
    </p>

    <p>
        {t.about.paragraph3}
        <strong class="text-gray-900 dark:text-white">
            {t.about.paragraph3Skill}
        </strong>
        {t.about.paragraph3End}
    </p>
</div>
