---
import { getTranslations } from "../i18n/utils";
const t = getTranslations(Astro.currentLocale);

const technologies = [
    [t.technologies.categories.languages, "Java · SQL · JavaScript · TypeScript"],
    ["Backend", "Spring Boot · Microservicios"],
    ["Frontend", "Angular · React · React Native · HTML · CSS"],
    [t.technologies.categories.data, "Oracle · PostgreSQL"],
    ["Testing", "JUnit · Mockito · PowerMock"],
    ["DevOps", "Jenkins · Git · Subversion"],
    [t.technologies.categories.management, "ServiceNow · Agile"],
    [t.technologies.categories.IA, "Codex · "+t.technologies.categories.IA_items.agents+ " · Skills · "+ t.technologies.categories.IA_items.automation],
];
---

<div class="grid gap-4 sm:grid-cols-2">
	{
		technologies.map(([label, values]) => (
			<div class="rounded-lg border border-gray-200 bg-white/60 p-4 dark:border-gray-800 dark:bg-white/[0.03]">
				<h3 class="text-sm font-semibold text-gray-900 dark:text-white">
					{label}
				</h3>
				<p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
					{values}
				</p>
			</div>
		))
	}
</div>
