---
import HomeIcon from "../components/icons/Home.astro";
import AboutMeIcon from "../components/icons/AboutMeIcon.astro";
import ExperienceIcon from "../components/icons/ExperienceIcon.astro";
import EducationIcon from "../components/icons/EducationIcon.astro";
import TechnologiesIcon from "../components/icons/TechnologiesIcon.astro";
import ProjectsIcon from "../components/icons/ProjectsIcon.astro";
import LanguageButton from "./LanguageButton.jsx";
import ThemeSelector from "./ThemeSelector.astro";
import { getTranslations } from "../i18n/utils";

const t = getTranslations(Astro.currentLocale);

const navItems = [
    {
        title: t.nav.home,
        linkHref: "#home",
        icon: HomeIcon,
    },
    {
        title: t.nav.about,
        linkHref: "#aboutme",
        icon: AboutMeIcon,
    },
    {
        title: t.nav.experience,
        linkHref: "#experience",
        icon: ExperienceIcon,
    },
    {
        title: t.nav.technologies,
        linkHref: "#technologies",
        icon: TechnologiesIcon,
    },
    {
        title: t.nav.education,
        linkHref: "#education",
        icon: EducationIcon,
    },
    {
        title: t.nav.projects,
        linkHref: "#projects",
        icon: ProjectsIcon,
    }
];
---

<header
    class="
        fixed inset-x-0 top-0 z-50
        border-b border-gray-200/70
        bg-white/90 backdrop-blur
        dark:border-gray-800/80
        dark:bg-gray-950/90

        lg:inset-y-0
        lg:right-auto
        lg:w-52
        lg:border-b-0
        lg:border-r
    "
>
    <nav
        class="
            mx-auto
            flex max-w-7xl flex-col

            lg:h-full
            lg:max-w-none
            lg:px-5
            lg:py-8
        "
    >
        <!-- Cabecera -->
        <div
            class="
                flex items-center justify-between
                px-4 py-3

                lg:block
                lg:px-0
                lg:py-0
            "
        >
            <a
                href="#home"
                class="
                    text-sm font-semibold
                    text-gray-900 dark:text-white
                "
            >
                Pablo Gamo
            </a>

            <!-- Controles móviles -->
            <div class="flex items-center gap-2 lg:hidden">
                <LanguageButton client:load />
                <ThemeSelector variant="mobile"/>
            </div>
        </div>

        <!-- Navegación -->
        <div
            class="
                flex items-center
                gap-1
                overflow-x-auto
                border-t border-gray-100
                px-3 py-2

                dark:border-gray-800

                lg:flex
                lg:flex-1
                lg:flex-col
                lg:items-stretch
                lg:justify-center
                lg:gap-4
                lg:overflow-visible
                lg:border-0
                lg:px-0
                lg:py-0
            "
        >
            {
                navItems.map((link) => (
                    <a
                        href={link.linkHref}
                        class="
                            shrink-0
                            rounded-lg
                            px-3 py-2
                            text-sm
                            text-gray-600
                            transition

                            hover:bg-gray-100
                            hover:text-gray-900
                            hover:scale-[1.15]

                            dark:text-gray-300
                            dark:hover:bg-gray-800
                            dark:hover:text-white

                            lg:px-3
                        "
                    >
                        <div
                            class="
                                flex items-center justify-center gap-2
                                lg:justify-start
                            "
                        >
                            <link.icon
                                width={20}
                                height={20}
                            />

                            <span>{link.title}</span>
                        </div>
                    </a>
                ))
            }
        </div>

        <!-- Controles escritorio -->
        <div
            class="
                hidden
                lg:flex
                lg:items-center
                lg:gap-2
                lg:pt-6
            "
        >
            <LanguageButton client:load />
            <ThemeSelector variant="desktop"/>
        </div>
    </nav>
</header>