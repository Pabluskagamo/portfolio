---
import HomeIcon from "../components/icons/Home.astro";
import AboutMeIcon from "../components/icons/AboutMeIcon.astro";
import ExperienceIcon from "../components/icons/ExperienceIcon.astro";
import ContactIcon from "../components/icons/Contact.astro";
import LanguageButton from "./LanguageButton.jsx";

const navItems = [
    { title: "Inicio", linkHref: "#home", icon: HomeIcon, iconSize: 20 },
    { title: "Sobre mí", linkHref: "#aboutme", icon: AboutMeIcon, iconSize: 20 },
    { title: "Experiencia", linkHref: "#experience", icon: ExperienceIcon, iconSize: 20 },
    { title: "Proyectos", linkHref: "#projects", icon: ContactIcon, iconSize: 20 },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-gray-200/70 bg-white/80 backdrop-blur dark:border-gray-800/80 dark:bg-gray-950/80 lg:inset-y-0 lg:right-auto lg:w-52 lg:border-b-0 lg:border-r">
    <nav class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3 lg:h-full lg:max-w-none lg:flex-col lg:items-stretch lg:px-5 lg:py-8">
        <a href="#home" class="hidden text-sm font-semibold text-gray-900 dark:text-white lg:block">
            Pablo Gamo
        </a>

        <div class="flex flex-1 items-center justify-center gap-1 overflow-x-auto lg:flex-none lg:flex-col lg:items-stretch lg:justify-center lg:gap-4">
            {navItems.map((link) => (
                <a
                    href={link.linkHref}
                    class="shrink-0 rounded-lg px-2 py-2 text-sm text-gray-600 transition hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white lg:px-3"
                >
                    <div class="flex items-center justify-center gap-2 lg:justify-start">
                        <link.icon width={link.iconSize} height={link.iconSize} />
                        <span>{link.title}</span>
                    </div>
                </a>
            ))}
        </div>

        <div class="hidden lg:block">
            <LanguageButton client:load />
        </div>
    </nav>
</header>
