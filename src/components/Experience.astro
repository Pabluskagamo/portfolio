---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
    {
        title: "Programador Analista · NTT DATA",
        description:
            "Evolutivos de alto impacto para un sistema crítico de un importante cliente del sector energético nacional, participando en el ciclo completo de desarrollo, desde requisitos y diseño hasta SAT y puesta en producción.",
        bullets: [
            "Análisis de requisitos, contacto con cliente y diseño de soluciones.",
            "Desarrollo y testing con Java, Oracle SQL y Angular.",
            "Coordinación de equipos de programadores y seguimiento de evolutivos.",
            "Introducción de IA generativa y agentes (Codex) mediante skills y automatizaciones aplicadas al desarrollo y ejecución de casos de uso.",
        ],
        date: "Actualidad",
    },
    {
        title: "Programador Junior · NTT DATA",
        description:
            "Desarrollo full-stack y mantenimiento evolutivo de un sistema legacy crítico para un importante cliente del sector energético nacional.",
        bullets: [
            "Desarrollo con Java, Oracle SQL y Angular.",
            "Testing unitario con JUnit y gestión de código con Git y Subversion.",
            "Procesos CI/CD mediante Jenkins.",
            "Gestión y resolución de incidencias con ServiceNow.",
        ],
        date: "Abril 2024 - Septiembre 2025",
    },
    {
        title: "Becario / Prácticas · NTT DATA",
        description:
            "Desarrollo backend con Java y Spring Boot en arquitecturas de microservicios, participando en equipos Agile y en procesos de testing y CI/CD.",
        bullets: [
            "Java, Spring Boot, Oracle y PostgreSQL.",
            "Testing con JUnit, Mockito y PowerMock.",
            "Control de versiones con Git y Subversion.",
            "CI/CD mediante Jenkins.",
        ],
        date: "Mayo 2023 - Enero 2024",
    },
];
---

<ol class="relative border-s border-gray-200 dark:border-gray-700">
    {EXPERIENCE.map((exp) => (
        <li class="mb-10 ms-4 last:mb-0">
            <ExperienceItem {...exp} />
        </li>
    ))}
</ol>
