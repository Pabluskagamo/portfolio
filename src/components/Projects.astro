---
import ProjectCard from "./ProjectCard.astro";

const project1 = {
	title: "SwiftDo",
	description:
		"Aplicación multiplataforma para gestión y priorización de tareas, con arquitectura REST, autenticación mediante OAuth 2.0, funcionamiento offline con sincronización automática e integración con Alexa mediante comandos de voz.",
	link: "https://github.com/SwiftDo-TFG/SwiftDo/tree/main",
	imgUrl:
		"https://github.com/SwiftDo-TFG/SwiftDo/blob/main/Frontend/src/assets/icon.png?raw=true",
	technologies: ["React Native", "Node.js", "REST", "OAuth 2.0", "PostgreSQL"]
};

const project2 = {
	title: "Try&Catch",
	description:
		"Plataforma orientada a estudiantes universitarios para formular preguntas, compartir respuestas y consultar información sobre universidades y carreras.",
	link: "https://github.com/Alejandrodlrio/IW",
	imgUrl: "/img/logo_TryCatch.png",
	technologies: ["Java", "Spring Boot", "Bootstrap"]
};


const projects = [project1, project2];
---

<div class="flex flex-col gap-8">
	{
		projects.map((project) => (
			<ProjectCard {...project} />
		))
	}
</div>