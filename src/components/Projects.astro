---
import ProjectCard from "./ProjectCard.astro";
import { getTranslations } from "../i18n/utils";
const t = getTranslations(Astro.currentLocale);

const project1 = {
	title: "SwiftDo",
	description: t.projects.project1.description,
	link: "https://github.com/SwiftDo-TFG/SwiftDo/tree/main",
	imgUrl:
		"https://github.com/SwiftDo-TFG/SwiftDo/blob/main/Frontend/src/assets/icon.png?raw=true",
	technologies: ["React Native", "Node.js", "REST", "OAuth 2.0", "PostgreSQL"]
};

const project2 = {
	title: "Try&Catch",
	description: t.projects.project2.description,
	link: "https://github.com/Alejandrodlrio/IW",
	imgUrl: `${import.meta.env.BASE_URL}img/logo_TryCatch.png`,
	technologies: ["Java", "Spring Boot", "Bootstrap"]
};


const projects = [project1, project2];
---

<div class="flex flex-col gap-8 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
	{
		projects.map((project) => (
			<ProjectCard {...project} />
		))
	}
</div>