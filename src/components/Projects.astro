---
import IconPill from "./IconPill.astro";
import ProjectCard from "./ProjectCard.astro";
import { TbBrandReactNative } from "react-icons/tb";
import { FaNodeJs, FaJava, FaBootstrap } from "react-icons/fa";
import { BiLogoPostgresql, BiLogoSpringBoot } from "react-icons/bi";

const project = {
    title: "SwiftDo",
    description:
        "Aplicación multiplataforma para gestión y priorización de tareas, con arquitectura REST, autenticación OAuth 2.0, funcionamiento offline con sincronización automática e integración con Alexa mediante comandos de voz.",
    link: "https://github.com/SwiftDo-TFG/SwiftDo/tree/main",
    imgUrl: "https://github.com/SwiftDo-TFG/SwiftDo/blob/main/Frontend/src/assets/icon.png?raw=true",
};

const project2 = {
    title: "Try&Catch",
    description:
        "Plataforma web colaborativa para estudiantes universitarios, orientada a resolver dudas académicas y facilitar el acceso a información sobre universidades y titulaciones.",
    link: "https://github.com/Alejandrodlrio/IW",
    imgUrl: "/img/logo_TryCatch.png",
};
---

<div class="flex flex-col gap-8">
    <ProjectCard {...project}>
        <p class="mb-4 text-sm leading-6 text-gray-700 dark:text-gray-400">{project.description}</p>
        <p class="pb-2 text-xs text-gray-700 dark:text-gray-400"><b>{project.title}</b> · Stack principal</p>
        <div class="flex flex-wrap gap-2">
            <IconPill small={true}>React Native <TbBrandReactNative /></IconPill>
            <IconPill small={true}>Node.js <FaNodeJs /></IconPill>
            <IconPill small={true}>PostgreSQL <BiLogoPostgresql /></IconPill>
        </div>
    </ProjectCard>

    <ProjectCard {...project2}>
        <p class="mb-4 text-sm leading-6 text-gray-700 dark:text-gray-400">{project2.description}</p>
        <p class="pb-2 text-xs text-gray-700 dark:text-gray-400"><b>{project2.title}</b> · Stack principal</p>
        <div class="flex flex-wrap gap-2">
            <IconPill small={true}>Java <FaJava /></IconPill>
            <IconPill small={true}>Spring Boot <BiLogoSpringBoot /></IconPill>
            <IconPill small={true}>Bootstrap <FaBootstrap /></IconPill>
        </div>
    </ProjectCard>
</div>
