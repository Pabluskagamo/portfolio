---
import HomeIcon from "../components/icons/Home.astro";
import AboutMeIcon from "../components/icons/AboutMeIcon.astro";
import ExperienceIcon from "../components/icons/ExperienceIcon.astro";
import ContactIcon from "../components/icons/Contact.astro";
import LanguageButton from "./LanguageButton.jsx"

const navItems = [
    {
        title: "Home",
        linkHref: "#home",
        icon: HomeIcon,
        iconSize: 20,
    },
    {
        title: "About me",
        linkHref: "#aboutme",
        icon: AboutMeIcon,
        iconSize: 20,
    },
    {
        title: "Experience",
        linkHref: "#experience",
        icon: ExperienceIcon,
        iconSize: 20,
    },
    {
        title: "Projects",
        linkHref: "#projects",
        icon: ContactIcon,
        iconSize: 20,
    },
];
---

<header class="fixed flex h-screen">
    <nav
        class="flex flex-col justify-center align-center self-center gap-y-5 m-10 opacity-80"
    >
        {
            navItems.map((link) => {
                return (
                    <a href={link.linkHref}>
                        <div class="flex items-center transition hover:text-yellow-500 dark:hover:text-yellow-400 hover:scale-110">
                            <link.icon
                                width={link.iconSize}
                                height={link.iconSize}
                            />
                            <h1 class="ml-2 text-xl">{link.title}</h1>
                        </div>
                    </a>
                );
            })
        }
        <div>
            <LanguageButton client:load/>
        </div>
    </nav>
</header>
