---
interface Props {
    title: string;
    description: string;
    link?: string;
    imgUrl: string;
}

const { title, description, link, imgUrl } = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800 md:flex-row">
    <img
        class="h-56 w-full object-cover md:h-auto md:w-48 md:shrink-0"
        src={imgUrl}
        alt={`Imagen del proyecto ${title}`}
        loading="lazy"
    />
    <div class="flex flex-1 flex-col justify-between p-5 leading-normal">
        <div>
            <h3 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white">{title}</h3>
            <slot />
        </div>
        {link && (
            <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex w-fit font-medium text-blue-600 hover:underline dark:text-blue-500"
            >
                Ver proyecto ↗
            </a>
        )}
    </div>
</article>
