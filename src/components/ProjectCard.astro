---
interface Props {
    title: string;
    description: string;
    link?: string;
    imgUrl: string;
}

const { title, description, link, imgUrl } = Astro.props;
---

<div class="flex flex-col items-center bg-white border border-gray-200 rounded-lg shadow md:flex-row hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700">
    
    <img class="object-cover w-full rounded-t-lg h-96 md:h-81 md:w-60 md:rounded-none md:rounded-s-lg" src={imgUrl} alt="">
    <div class="flex flex-col justify-between p-5 leading-normal">
        <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{title}</h5>
        <slot/>        
        <a href={link} class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Descubre más</a>
    </div>
</div>