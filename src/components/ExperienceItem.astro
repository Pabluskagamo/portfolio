---
interface Props {
    title: string;
    company: string;
    description: string;
    date: string;
    bullets?: string[];
    link?: string;
}

const { title, company, description, date, bullets = [], link } = Astro.props;
---

<div
    class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700"
></div>

<time
    class="mb-1 text-sm font-medium leading-none text-gray-400 dark:text-gray-500"
>
    {date}
</time>

<h3 class="text-xl font-semibold text-gray-900 dark:text-white mt-2">
    {title}
</h3>

<p class="text-sm font-medium text-yellow-600 dark:text-yellow-300 mt-1 mb-3">
    {company}
</p>

<p class="mb-4 text-base leading-relaxed text-gray-600 dark:text-gray-400">
    {description}
</p>

{
    bullets.length > 0 && (
        <ul class="list-disc pl-5 space-y-2 text-base text-gray-600 dark:text-gray-400">
            {bullets.map((bullet) => (
                <li>{bullet}</li>
            ))}
        </ul>
    )
}

{
    link && (
        <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center mt-4 font-medium text-blue-600 dark:text-blue-500 hover:underline"
        >
            Saber más →
        </a>
    )
}
