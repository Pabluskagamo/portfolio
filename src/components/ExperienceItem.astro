---
interface Props {
    title: string;
    description: string;
    date: string;
    bullets?: string[];
    link?: string;
}

const { title, description, date, bullets = [], link } = Astro.props;
---

<div
    class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700"
></div>
<time class="mb-1 block text-sm font-medium leading-none text-gray-400 dark:text-gray-500">
    {date}
</time>
<h3 class="mt-1 text-lg font-semibold text-gray-900 dark:text-white">
    {title}
</h3>
<p class="mt-2 text-sm md:text-base leading-6 text-gray-600 dark:text-gray-400">
    {description}
</p>
{bullets.length > 0 && (
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-6 text-gray-600 dark:text-gray-400">
        {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
)}
{link && (
    <a
        href={link}
        class="mt-4 inline-flex items-center rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white dark:focus:ring-gray-700"
    >
        Saber más...
        <svg
            class="ms-2 h-3 w-3 rtl:rotate-180"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 14 10"
        >
            <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M1 5h12m0 0L9 1m4 4L9 9"
            />
        </svg>
    </a>
)}
