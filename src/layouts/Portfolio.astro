---
import SectionContainer from "../components/SectionContainer.astro";
import Experience from "../components/Experience.astro";
import IconPill from "../components/IconPill.astro";
import LinkedinIcon from "../components/icons/Linkedin.astro";
import GithubIcon from "../components/icons/Github.astro";
import MailIcon from "../components/icons/Mail.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import AboutMe from "../components/AboutMe.astro";
import Projects from "../components/Projects.astro";

import { getTranslations } from "../i18n/utils";
import Education from "../components/Education.astro";
import Technologies from "../components/Technologies.astro";

const t = getTranslations(Astro.currentLocale);

const technologies = [
    ["Lenguajes", "Java · SQL · JavaScript · TypeScript"],
    ["Backend", "Spring Boot · Microservicios"],
    ["Frontend", "Angular · React · React Native · HTML · CSS"],
    ["Datos", "Oracle · PostgreSQL"],
    ["Testing", "JUnit · Mockito · PowerMock"],
    ["DevOps", "Jenkins · Git · Subversion"],
    ["Gestión", "ServiceNow · Agile"],
    ["IA & Automatización", "Codex · Agentes de IA · Skills · Automatización"],
];
---

<main class="lg:pl-52">
    <SectionContainer
        id="home"
        class="scroll-mt-20 pb-12 pt-28 md:pb-16 lg:pt-20"
    >
        <div class="flex flex-col items-start">
            <img
                src="/img/FotoPerfil.jpg"
                alt="Foto de perfil de Pablo Gamo"
                class="mb-5 h-28 w-28 rounded-full object-cover sm:h-36 sm:w-36"
            />
            <p
                class="mb-2 text-sm font-medium text-gray-500 dark:text-gray-400"
            >
                {t.hero.description}
            </p>
            <h1
                class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl md:text-5xl"
            >
                {t.hero.greeting}
            </h1>
            <nav
                class="mt-6 flex flex-wrap gap-2"
                aria-label="Redes y contacto"
            >
                <IconPill
                    href="https://www.linkedin.com/in/pablo-gamo-gonz%C3%A1lez-b48223267/"
                >
                    <LinkedinIcon class="size-4 md:size-5" />
                    LinkedIn
                </IconPill>
                <IconPill href="https://github.com/pabluskagamo">
                    <GithubIcon class="size-4 md:size-5" />
                    GitHub
                </IconPill>
                <IconPill href="mailto:pgamogonzalez@gmail.com">
                    <MailIcon class="size-4 md:size-5" />
                    pgamogonzalez@gmail.com
                </IconPill>
            </nav>
        </div>
    </SectionContainer>

    <SectionContainer class="mb-14 scroll-mt-20" id="aboutme">
        <h2
            class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl"
        >
            {t.about.title}
        </h2>
        <AboutMe />
    </SectionContainer>

    <SectionContainer class="mb-14 scroll-mt-20" id="experience">
        <h2
            class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl"
        >
            {t.experience.title}
        </h2>
        <Experience />
    </SectionContainer>

    <SectionContainer class="mb-14 scroll-mt-20" id="technologies">
        <h2
            class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl"
        >
            {t.technologies.title}
        </h2>
        <Technologies/>
    </SectionContainer>

    <SectionContainer class="mb-14 scroll-mt-20" id="education">
        <h2
            class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl"
        >
             {t.education.title}
        </h2>
        <Education/>
    </SectionContainer>

    <SectionContainer class="mb-14 scroll-mt-20" id="projects">
        <h2
            class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl"
        >
            {t.projects.title}
        </h2>
        <Projects />
    </SectionContainer>
    <ThemeSelector />
</main>
