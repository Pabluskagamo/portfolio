---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Experience from "../components/Experience.astro";
import IconPill from "../components/IconPill.astro";
import LinkedinIcon from "../components/icons/Linkedin.astro";
import GithubIcon from "../components/icons/Github.astro";
import MailIcon from "../components/icons/Mail.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import AboutMe from "../components/AboutMe.astro";
import Projects from "../components/Projects.astro";

const technologies = [
    ["Lenguajes", "Java · SQL · JavaScript · TypeScript"],
    ["Backend", "Spring Boot · Microservicios"],
    ["Frontend", "Angular · React · React Native · HTML · CSS"],
    ["Datos", "Oracle · PostgreSQL"],
    ["Testing", "JUnit · Mockito · PowerMock"],
    ["DevOps", "Jenkins · Git · Subversion"],
    ["Gestión", "ServiceNow · Agile"],
    ["IA & Automatización", "Codex · Agentes de IA · Skills · Automatización"],
];
---

<Layout
    title="Pablo Gamo · Ingeniero de Software"
    description="Portfolio de Pablo Gamo, Ingeniero de Software especializado en desarrollo full-stack e IA aplicada al desarrollo de software."
>
    <main class="lg:pl-52">
        <SectionContainer id="home" class="scroll-mt-20 pb-12 pt-28 md:pb-16 lg:pt-20">
            <div class="flex flex-col items-start">
                <img
                    src="/img/FotoPerfil.jpg"
                    alt="Foto de perfil de Pablo Gamo"
                    class="mb-5 h-28 w-28 rounded-full object-cover sm:h-36 sm:w-36"
                />
                <p class="mb-2 text-sm font-medium text-gray-500 dark:text-gray-400">Ingeniero de Software · Programador Analista</p>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl md:text-5xl">
                    ¡Hola! Soy Pablo Gamo
                </h1>
                <nav class="mt-6 flex flex-wrap gap-2" aria-label="Redes y contacto">
                    <IconPill href="https://www.linkedin.com/in/pablo-gamo-gonz%C3%A1lez-b48223267/">
                        <LinkedinIcon class="size-4 md:size-5" />
                        LinkedIn
                    </IconPill>
                    <IconPill href="https://github.com/pabluskagamo">
                        <GithubIcon class="size-4 md:size-5" />
                        GitHub
                    </IconPill>
                    <IconPill href="mailto:pgamogonzalez@gmail.com">
                        <MailIcon class="size-4 md:size-5" />
                        pgamogonzalez@gmail.com
                    </IconPill>
                </nav>
            </div>
        </SectionContainer>

        <SectionContainer class="mb-14 scroll-mt-20" id="aboutme">
            <h2 class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl">Sobre mí</h2>
            <AboutMe />
        </SectionContainer>

        <SectionContainer class="mb-14 scroll-mt-20" id="experience">
            <h2 class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl">Experiencia</h2>
            <Experience />
        </SectionContainer>

        <SectionContainer class="mb-14 scroll-mt-20" id="technologies">
            <h2 class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl">Tecnologías</h2>
            <div class="grid gap-4 sm:grid-cols-2">
                {technologies.map(([label, values]) => (
                    <div class="rounded-lg border border-gray-200 bg-white/60 p-4 dark:border-gray-800 dark:bg-white/[0.03]">
                        <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{label}</h3>
                        <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">{values}</p>
                    </div>
                ))}
            </div>
        </SectionContainer>

        <SectionContainer class="mb-14 scroll-mt-20" id="education">
            <h2 class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl">Educación</h2>
            <div class="space-y-4 rounded-xl border border-gray-200 bg-white/60 p-5 dark:border-gray-800 dark:bg-white/[0.03]">
                <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Grado en Ingeniería del Software</h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Universidad Complutense de Madrid · Promoción 2024</p>
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-gray-700 dark:text-gray-300">
                    <span><strong>Nota media:</strong> 8,3/10</span>
                    <span><strong>7 Matrículas de Honor</strong></span>
                </div>
                <p class="text-sm leading-6 text-gray-700 dark:text-gray-300"><strong>Diploma al Mejor Expediente Académico</strong> del Grado en Ingeniería del Software · Promoción 2024.</p>
            </div>
        </SectionContainer>

        <SectionContainer class="mb-14 scroll-mt-20" id="projects">
            <h2 class="mb-6 text-2xl font-semibold underline decoration-2 underline-offset-4 sm:text-3xl">Proyectos</h2>
            <Projects />
        </SectionContainer>

        <SectionContainer class="pb-24 sm:pb-32">
            <div class="grid gap-4 rounded-xl border border-gray-200 bg-white/60 p-5 text-sm text-gray-600 dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-400 sm:grid-cols-2">
                <div>
                    <h2 class="font-semibold text-gray-900 dark:text-white">Idiomas</h2>
                    <p class="mt-1">Castellano (Nativo) · Inglés (B2)</p>
                </div>
                <div>
                    <h2 class="font-semibold text-gray-900 dark:text-white">Otros datos</h2>
                    <p class="mt-1">Permiso de conducir B · Disponibilidad presencial, híbrida o remota</p>
                </div>
            </div>
        </SectionContainer>

        <ThemeSelector />
    </main>
</Layout>
